# Base local. Todas las variables son opcionales.
LEARNUP_DATABASE_URL=duckdb:///learn_up.duckdb
LEARNUP_DB_SCHEMA=learn
LEARNUP_FRONTEND_PORT=5173
LEARNUP_BACKEND_PORT=8011

# Token local. Si se omite, se genera uno criptográficamente seguro al iniciar.
# LEARNUP_API_TOKEN=

# Backend de preguntas sobre el material: claude_cli, codex_cli u openhands.
LEARNUP_LLM_BACKEND=codex_cli
LEARNUP_CLAUDE_CLI_MODEL=sonnet

# Solo para OpenHands. Incluso un modelo local requiere una clave de marcador.
LEARNUP_LLM_MODEL=anthropic/claude-sonnet-4-5
# LEARNUP_LLM_API_KEY=
# LEARNUP_LLM_BASE_URL=

# Perfil autenticado que usa la generación opcional de videos.
LEARNUP_NOTEBOOKLM_PROFILE=default

# Edición alojada. El modelo y los límites siguientes están aprobados, pero deben
# configurarse en Sites. OPENAI_API_KEY y LEARNUP_SAFETY_IDENTIFIER_SALT se guardan
# como secretos de Sites, nunca en este archivo ni en Git.
LEARNUP_QA_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_VECTOR_STORE_ID=
# LEARNUP_SAFETY_IDENTIFIER_SALT=
# LEARNUP_QA_CURRENT_CREDITS=1
# LEARNUP_QA_FULL_SOURCE_CREDITS=3
# LEARNUP_QA_USER_DAILY_CREDITS=20
# LEARNUP_QA_USER_MONTHLY_CREDITS=150
# LEARNUP_QA_GLOBAL_MONTHLY_CREDITS=500
# LEARNUP_QA_USER_REQUESTS_PER_MINUTE=3
# LEARNUP_QA_USER_MAX_CONCURRENCY=1
# LEARNUP_QA_SELECTION_MAX_CHARS=3000
# LEARNUP_QA_QUESTION_MAX_CHARS=800
# LEARNUP_QA_MAX_OUTPUT_TOKENS=700
# LEARNUP_QA_MAX_RETRIEVAL_RESULTS=6
# LEARNUP_QA_MAX_TOOL_CALLS=1
# LEARNUP_QA_TIMEOUT_MS=30000
