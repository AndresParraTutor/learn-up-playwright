# Base local. Todas las variables son opcionales.
LEARNUP_DATABASE_URL=duckdb:///learn_up.duckdb
LEARNUP_DB_SCHEMA=learn
LEARNUP_FRONTEND_PORT=5173
LEARNUP_BACKEND_PORT=8011

# Token local. Si se omite, se genera uno criptográficamente seguro al iniciar.
# LEARNUP_API_TOKEN=

# Backend de preguntas: agy_cli (predeterminado), codex_cli, claude_cli u openhands.
# Instalá y autenticá el cliente elegido en el mismo entorno que el back-end.
LEARNUP_LLM_BACKEND=agy_cli
# Opcional: un identificador de modelo disponible en `agy models`.
# LEARNUP_AGY_CLI_MODEL=
LEARNUP_CLAUDE_CLI_MODEL=sonnet
